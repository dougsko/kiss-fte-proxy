# Example environment file for the KISS FTE Proxy quadlet
# Copy to /etc/kiss-fte-proxy/kiss-fte-proxy.env and edit as needed

# Upstream KISS client connection address (where your KISS app sends frames)
APP_HOST=127.0.0.1
APP_PORT=8001

# Direwolf / TNC KISS port address
TNC_HOST=127.0.0.1
TNC_PORT=8002

# Callsign configuration
SRC_CALL=NODEA-1
DST_CALL=NODEB-1

# Narrator selection (bbs7plus or aprs)
BBS_NARRATOR=bbs7plus

# Optional overrides
# SMALL_CTRL_THRESHOLD=32
# MAX_PLAINTEXT_CHUNK=110